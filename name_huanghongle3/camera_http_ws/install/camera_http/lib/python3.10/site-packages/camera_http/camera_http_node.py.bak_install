#!/usr/bin/env python3
"""
HTTP MJPEG Camera Server for ROS2
Subscribes to camera image and serves as HTTP MJPEG stream
智能话题切换：优先使用 /detection/image，如果没有数据则自动回退到 /camera/color/image_raw
"""

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image
from cv_bridge import CvBridge
import cv2
import threading
import socketserver
from http.server import BaseHTTPRequestHandler
import io
import numpy as np


class MJPEGHandler(BaseHTTPRequestHandler):
    """HTTP Handler for MJPEG streaming"""
    
    # Class variable to share frame data between threads
    latest_frame = None
    frame_lock = threading.Lock()
    
    def do_GET(self):
        if self.path == '/camera' or self.path == '/':
            self.send_response(200)
            self.send_header('Content-type', 'multipart/x-mixed-replace; boundary=--jpgboundary')
            self.send_header('Access-Control-Allow-Origin', '*')  # Allow CORS
            self.end_headers()
            
            self.server.node.get_logger().info('Client connected to camera stream')
            
            try:
                while True:
                    with MJPEGHandler.frame_lock:
                        frame = MJPEGHandler.latest_frame
                    
                    if frame is not None:
                        # Encode frame to JPEG
                        ret, jpeg = cv2.imencode('.jpg', frame)
                        if ret:
                            self.wfile.write(b'--jpgboundary\r\n')
                            self.send_header('Content-type', 'image/jpeg')
                            self.send_header('Content-length', len(jpeg))
                            self.end_headers()
                            self.wfile.write(jpeg.tobytes())
                            self.wfile.write(b'\r\n')
                    
                    # Control frame rate (10fps = 100ms delay)
                    import time
                    time.sleep(0.1)
                    
            except (BrokenPipeError, ConnectionResetError):
                self.server.node.get_logger().info('Client disconnected')
        else:
            self.send_response(404)
            self.end_headers()
    
    def log_message(self, format, *args):
        # Suppress default HTTP logging
        pass


class ThreadedHTTPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    """Threaded HTTP Server"""
    allow_reuse_address = True
    daemon_threads = True


class CameraHTTPServer(Node):
    def __init__(self):
        super().__init__('camera_http_server')
        
        # Parameters
        self.declare_parameter('primary_topic', '/detection/image')
        self.declare_parameter('fallback_topic', '/camera/color/image_raw')
        self.declare_parameter('fallback_timeout', 3.0)  # 回退超时时间（秒）
        self.declare_parameter('port', 8082)
        self.declare_parameter('host', '0.0.0.0')
        self.declare_parameter('resize_width', 1280)
        self.declare_parameter('resize_height', 720)
        self.declare_parameter('jpeg_quality', 80)
        
        self.primary_topic = self.get_parameter('primary_topic').value
        self.fallback_topic = self.get_parameter('fallback_topic').value
        self.fallback_timeout = self.get_parameter('fallback_timeout').value
        port = self.get_parameter('port').value
        host = self.get_parameter('host').value
        self.resize_width = self.get_parameter('resize_width').value
        self.resize_height = self.get_parameter('resize_height').value
        self.jpeg_quality = self.get_parameter('jpeg_quality').value
        
        self.bridge = CvBridge()
        self.frame_count = 0
        self.last_frame_time = None
        self.current_topic = self.primary_topic
        self.subscription = None
        self.fallback_timer = None
        
        # Start HTTP server
        self.server = ThreadedHTTPServer((host, port), MJPEGHandler)
        self.server.node = self  # Pass node reference for logging
        
        self.server_thread = threading.Thread(target=self.server.serve_forever)
        self.server_thread.daemon = True
        self.server_thread.start()
        
        self.get_logger().info('='*50)
        self.get_logger().info(f'HTTP MJPEG Server started!')
        self.get_logger().info(f'URL: http://{host}:{port}/camera')
        self.get_logger().info(f'Streaming at: {self.resize_width}x{self.resize_height}')
        self.get_logger().info(f'Target FPS: 10')
        self.get_logger().info('='*50)
        
        # 首先尝试订阅主要话题
        self._subscribe_topic(self.primary_topic)
        
        # 创建回退检测定时器
        self.fallback_timer = self.create_timer(self.fallback_timeout, self._check_and_fallback)
        
        # FPS timer
        self.fps_timer = self.create_timer(1.0, self.print_fps)
    
    def _subscribe_topic(self, topic_name):
        """订阅指定话题"""
        if self.subscription is not None:
            self.destroy_subscription(self.subscription)
            self.subscription = None
        
        self.current_topic = topic_name
        self.subscription = self.create_subscription(
            Image,
            topic_name,
            self.image_callback,
            10
        )
        self.last_frame_time = self.get_clock().now()
        self.get_logger().info(f'已订阅话题: {topic_name}')
    
    def _check_and_fallback(self):
        """检查是否需要切换到备用话题"""
        # 如果已经在使用备用话题，无需再检查
        if self.current_topic == self.fallback_topic:
            return
        
        # 检查是否已经接收到帧
        now = self.get_clock().now()
        elapsed = (now - self.last_frame_time).nanoseconds / 1e9
        
        if self.frame_count == 0 and elapsed > self.fallback_timeout:
            self.get_logger().warn(f'话题 {self.primary_topic} 在 {self.fallback_timeout} 秒内没有数据！')
            self.get_logger().info(f'自动切换到备用话题: {self.fallback_topic}')
            self._subscribe_topic(self.fallback_topic)
            # 取消回退定时器，因为已经在使用备用话题了
            if self.fallback_timer is not None:
                self.fallback_timer.cancel()
    
    def print_fps(self):
        self.get_logger().info(f'FPS: {self.frame_count} (话题: {self.current_topic})')
        self.frame_count = 0
    
    def image_callback(self, msg):
        try:
            # Convert ROS Image to OpenCV
            cv_image = self.bridge.imgmsg_to_cv2(msg, "bgr8")
            
            # Resize to target resolution
            resized = cv2.resize(cv_image, (self.resize_width, self.resize_height))
            
            # Update latest frame (thread-safe)
            with MJPEGHandler.frame_lock:
                MJPEGHandler.latest_frame = resized
            
            self.frame_count += 1
            self.last_frame_time = self.get_clock().now()
            
        except Exception as e:
            self.get_logger().error(f'Error in image_callback: {e}')
    
    def destroy_node(self):
        self.get_logger().info('Shutting down HTTP server...')
        self.server.shutdown()
        self.server.server_close()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = CameraHTTPServer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
